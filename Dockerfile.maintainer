FROM node:22-bookworm-slim AS codex
RUN npm install --prefix /opt/codex --no-audit --no-fund @openai/codex@0.167.0-alpha.4

FROM python:3.13-slim-bookworm
COPY --from=codex /usr/local/bin/node /usr/local/bin/node
COPY --from=codex /opt/codex /opt/codex
ENV PATH="/opt/codex/node_modules/.bin:${PATH}" PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app
COPY requirements-maintainer.txt .
RUN pip install --no-cache-dir -r requirements-maintainer.txt
COPY *.py ./
RUN codex --version && python -m unittest test_codex_spending -q
CMD ["python", "maintainer_service.py"]
